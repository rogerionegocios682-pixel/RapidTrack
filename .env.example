# ===========================================================================
# Delivery_OS — variáveis de ambiente
# Copie para .env.local e preencha com os seus valores.
# ===========================================================================

# Connection string do Postgres do Supabase.
# No painel do Supabase: Settings -> Database -> Connection string -> URI.
#  - Para deploy serverless (Vercel), use o "Connection Pooler" (porta 6543):
#      postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
#  - Para uso local/scripts, a conexão direta (porta 5432) também funciona:
#      postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# (Opcional) URL direta, usada por scripts de migração/seed quando o pooler
# não suporta operações mais pesadas. Se vazia, usa DATABASE_URL.
DIRECT_URL=

# (Opcional) Força SSL. "true" habilita (obrigatório no Supabase); "false"
# desabilita (Postgres local em docker). Sem valor, é detectado pela URL.
DATABASE_SSL=

# Segredo para assinar o cookie de sessão (JWT HS256). Obrigatório em produção.
SESSION_SECRET=

# (Opcional) Credenciais do administrador criado pelo seed.
SEED_ADMIN_EMAIL=admin@deliveryos.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrador
