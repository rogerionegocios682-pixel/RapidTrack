{
  "name": "delivery-os",
  "version": "1.0.0",
  "private": true,
  "description": "Delivery_OS - Sistema de Gestão de Entregas e Motoboys",
  "scripts": {
    "dev": "node scripts/fix-env.js && next dev",
    "build": "node scripts/fix-env.js && next build",
    "start": "node scripts/fix-env.js && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed.mjs",
    "db:schema": "node scripts/seed.mjs --schema",
    "db:reset": "node scripts/seed.mjs --force",
    "db:migrate": "node scripts/migrate-to-postgres.mjs",
    "db:migrate:sync": "node scripts/migrate-sync.mjs",
    "db:sync:check": "node scripts/migrate-sync.mjs --check",
    "installer:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\installer\\build-windows.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.10.0",
    "sql.js": "^1.12.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
